  <!--
        for the following documentation:
          "item A" refers to the item whose content id is specified in the "id" attribute of the "dependency" tag
		  "condition D" refers to the condition tag that is specified in the "cond" attribute of the "dependency" tag
		  "entitlement E" refers to the entitlement tag that is specified in the "entitlement" attribute of the "dependency" tag
          "item B" refers to the item whose content id is specified in the type of dependency tag's id attribute

		the "show" attribute governs whether or not the item is shown if its prerequisites are not fulfilled. If show="true" then they are visible but nonpurchasable.

        <preclusion id="<contentid>" />
                preclusion   is where the purchase of item A, truth of condition D, or presence of entitlement E
				               "precludes" the purchase of item B
                id           is the content id of item B
				show		 true if want to show item B as disabled or false (default) to hide completely

        <prerequisite {id="<contentid>",entitlement="<tag>"} type="{and,or}" />
                prerequisite  is where item A cannot be purchased before purchasing item B and/or entitlement C
                id            is the content id of item B
				entitlement   is the tag of entitlement C
				cond		  is condition D
                type          use "and" to link one or more prerequisites as (B and C and D)
                              use "or" to link one or more prerequisites as (B or C or D)

                Specifying both types "and" and "or" for a single item will result in the "and"
                prerequisites only being evaluated. Ie. currently it is not possible to form
                simple expressions combining "and" and "or".

      -->
  <dependencies>
    <!-- if All Leagues purchased, can't buy any other types of Live Season items. Preclude even discounted items    because the EASST might expire, and the user could have already bought the discounted item.  Or the user could have bought the non discounted item and then subscribed to EASST -->
    <dependency id="LIVESEASONALL">
      <preclusion id="LIVESEASONENG" show="true" />
      <preclusion id="LIVESEASONFRA" show="true" />
      <preclusion id="LIVESEASONITA" show="true" />
      <preclusion id="LIVESEASONGER" show="true" />
      <preclusion id="LIVESEASONSPA" show="true" />
      <preclusion id="LIVESEASONTRIAL" show="true" />
      <preclusion id="LIVESEASONALLDISC" show="false" />
      <preclusion id="LIVESEASONENGDISC" show="false" />
      <preclusion id="LIVESEASONFRADISC" show="false" />
      <preclusion id="LIVESEASONITADISC" show="false" />
      <preclusion id="LIVESEASONGERDISC" show="false" />
      <preclusion id="LIVESEASONSPADISC" show="false" />
    </dependency>
    <dependency id="LIVESEASONALLDISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONENGDISC" show="true" />
      <preclusion id="LIVESEASONFRADISC" show="true" />
      <preclusion id="LIVESEASONITADISC" show="true" />
      <preclusion id="LIVESEASONGERDISC" show="true" />
      <preclusion id="LIVESEASONSPADISC" show="true" />
      <preclusion id="LIVESEASONTRIAL" show="true" />
      <preclusion id="LIVESEASONALL" show="false" />
      <preclusion id="LIVESEASONENG" show="false" />
      <preclusion id="LIVESEASONFRA" show="false" />
      <preclusion id="LIVESEASONITA" show="false" />
      <preclusion id="LIVESEASONGER" show="false" />
      <preclusion id="LIVESEASONSPA" show="false" />
    </dependency>
    <dependency id="LIVESEASONENGDISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONENG" show="false" />
    </dependency>
    <dependency id="LIVESEASONFRADISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONFRA" show="false" />
    </dependency>
    <dependency id="LIVESEASONITADISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONITA" show="false" />
    </dependency>
    <dependency id="LIVESEASONGERDISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONGER" show="false" />
    </dependency>
    <dependency id="LIVESEASONSPADISC" show="false">
      <prerequisite cond="EASST" type="or" />
      <preclusion id="LIVESEASONSPA" show="false" />
    </dependency>
    <dependency id="EURO2012DLCDSC" show="false">
      <prerequisite cond="EASST" type="or" />
    </dependency>
    <!-- if Creation Centre All-in-One purchased, can't buy any other types of Creation Centre items (show) -->
    <dependency id="CCALLINONE">
      <preclusion id="CCTOURNAMENTS" show="true" />
      <preclusion id="CCCAREERMODE" show="true" />
      <preclusion id="CCTEAMS1" show="true" />
      <preclusion id="CCTEAMS2" show="true" />
      <preclusion id="CCLICENSOR" show="true" />
      <preclusion id="CCSERIOUSEDITOR" show="true" />
    </dependency>
    <!-- if EASST subscribed to, can't buy any Creation Centre items (show), or the non-discounted items (hide). -->
    <dependency cond="EASST">
      <preclusion id="CCALLINONE" show="true" />
      <preclusion id="CCTOURNAMENTS" show="true" />
      <preclusion id="CCCAREERMODE" show="true" />
      <preclusion id="CCTEAMS1" show="true" />
      <preclusion id="CCTEAMS2" show="true" />
      <preclusion id="CCLICENSOR" show="true" />
      <preclusion id="CCSERIOUSEDITOR" show="true" />
      <preclusion id="LIVESEASONENG" show="false" />
      <preclusion id="LIVESEASONFRA" show="false" />
      <preclusion id="LIVESEASONITA" show="false" />
      <preclusion id="LIVESEASONGER" show="false" />
      <preclusion id="LIVESEASONSPA" show="false" />
      <preclusion id="LIVESEASONALL" show="false" />
      <preclusion id="EURO2012DLCKEY" show="false" />
    </dependency>
  </dependencies>
